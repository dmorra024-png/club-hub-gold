{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "node --test --experimental-test-isolation=none tests/*.test.ts tests/*.test.mjs",
    "test:smoke:accounts": "node scripts/smoke-account-security.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tests.json --noEmit",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local .output/server/index.mjs",
    "test:browser": "node scripts/test-pwa.mjs && node scripts/test-member-administration.mjs",
    "assets:import": "node scripts/import-brand-assets.mjs",
    "sandbox:prepare": "node scripts/prepare-sandbox.mjs",
    "dev:sandbox": "vite dev --mode sandbox --host 0.0.0.0 --port 3000",
    "test:sandbox:login": "node scripts/verify-sandbox-login.mjs",
    "test:dev:preview": "node scripts/verify-development-preview.mjs",
    "test:sandbox:administration": "node scripts/test-native-administration.mjs",
    "test:sandbox:ai": "node scripts/test-administrative-ai.mjs",
    "test:sandbox:mobile": "node scripts/test-mobile-administration.mjs",
    "test:security:bundle": "node scripts/verify-client-secrets.mjs",
    "build:worker": "SNOOP_RUNTIME=cloudflare vite build --mode pilot",
    "build:worker:test": "SNOOP_RUNTIME=cloudflare vite build --mode sandbox",
    "worker:dry-run": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --config .output/server/wrangler.json --outdir .sandbox/cloudflare-dry-run",
    "test:worker": "node scripts/prepare-worker-test.mjs && node scripts/test-worker.mjs",
    "pilot:database": "node scripts/prepare-pilot-database.mjs",
    "pilot:secrets": "node scripts/prepare-pilot-secrets.mjs",
    "test:security:initialization": "node --test tests/initialization-security.test.mjs",
    "test:security:architecture": "node --test --experimental-test-isolation=none tests/platform-separation.test.mjs tests/access-context.test.ts tests/platform-management.test.ts tests/account-access.test.ts",
    "test:voice:activation": "node --test --experimental-test-isolation=none tests/voice-activation.test.ts tests/snoop-runtime-bindings.test.mjs",
    "test:voice:browser": "node scripts/test-voice-forms.mjs",
    "test:completion:mobile": "node scripts/test-snoop-completion.mjs",
    "test:account-links": "node scripts/test-account-links.mjs",
    "test:pwa:resume": "node scripts/test-pwa-resume.mjs",
    "test:premium:home": "node scripts/test-premium-home.mjs"
  },
