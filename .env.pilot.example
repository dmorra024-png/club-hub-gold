# Copy to .env.pilot.local. Keep all keys private; use only a NEW dedicated SNOOP project.
SNOOP_RESOURCE_NAMESPACE=snoop-pilot
SNOOP_SUPABASE_PROJECT_REF=REPLACE_WITH_DEDICATED_SNOOP_PROJECT_REF
VITE_SUPABASE_URL=https://REPLACE_WITH_DEDICATED_SNOOP_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_ANON_KEY
SUPABASE_URL=https://REPLACE_WITH_DEDICATED_SNOOP_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_PRIVATE_SERVICE_ROLE_KEY
APP_URL=https://snoop-pilot.YOUR_SUBDOMAIN.workers.dev
AI_PROVIDER=cloudflare
AI_EXTERNAL_PROCESSING_ENABLED=false
AI_PERSONAL_DATA_PROCESSING_ENABLED=false
AI_DOCUMENT_PROCESSING_ENABLED=false
AI_BROWSER_SPEECH_ENABLED=false
SNOOP_INVITATION_DELIVERY=manual
