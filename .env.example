# Independent server installation. Copy to a PRIVATE .env.local and fill in values.
# Never use a production database for automated tests; use npm run sandbox:prepare.
APP_URL=https://snoop.example.invalid
VITE_SUPABASE_URL=https://database.example.invalid
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=https://database.example.invalid
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI configuration. No AI_* variable may use the VITE_ prefix.
# Keep disabled until the operator authorizes this provider and data processing.
AI_EXTERNAL_PROCESSING_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_AUTHORIZED_ORIGIN=
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AI_TTS_MODEL=gpt-4o-mini-tts
AI_TTS_VOICE=ash
# Documents and the browser vendor's speech service require separate authorization.
AI_DOCUMENT_PROCESSING_ENABLED=false
AI_BROWSER_SPEECH_ENABLED=false
# Optional: only for a compatible image-generation model; otherwise manual image upload.
AI_IMAGE_MODEL=

EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_WEBHOOK_SECRET=

# Free pilot (Cloudflare binding only, no REST key):
# AI_PROVIDER=cloudflare
# AI_PERSONAL_DATA_PROCESSING_ENABLED=false
# SNOOP_INVITATION_DELIVERY=manual
